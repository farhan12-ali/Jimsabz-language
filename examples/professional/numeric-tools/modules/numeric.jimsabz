kam totalValues(qatar dec values) -> dec {
    dec total = 0.0
    gin value andar values { total += value }
    wapas total
}

kam minimumValue(qatar dec values) -> dec {
    dec result = values[0]
    gin value andar values { jey (value < result) { result = value } }
    wapas result
}

kam maximumValue(qatar dec values) -> dec {
    dec result = values[0]
    gin value andar values { jey (value > result) { result = value } }
    wapas result
}

kam siftValues(qatar dec values, adad size, adad root) -> khali {
    wori (root * 2 + 1 < size) {
        adad child = root * 2 + 1
        jey (child + 1 < size) {
            jey (values[child] < values[child + 1]) { child += 1 }
        }
        jey (values[root] <= values[child]) {
            dec saved = values[root]
            values[root] = values[child]
            values[child] = saved
            root = child
        } na_ta { rok }
    }
}
kam sortValues(qatar dec values) -> khali {
    adad start = values.lambai / 2 - 1
    wori (start >= 0) {
        siftValues(values, values.lambai, start)
        start -= 1
    }
    adad end = values.lambai - 1
    wori (end > 0) {
        dec saved = values[0]
        values[0] = values[end]
        values[end] = saved
        siftValues(values, end, 0)
        end -= 1
    }
}

kam medianValue(qatar dec values) -> dec {
    adad middle = values.lambai / 2
    jey (values.lambai % 2 == 0) { wapas (values[middle - 1] + values[middle]) / 2.0 }
    wapas values[middle]
}
