{
  "name": "jimsabz-studio",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node api/server.mjs",
    "test:exe": "node tests/exe-api.test.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "test:professional": "node --test tests/professional.test.mjs tests/local-project.test.mjs",
    "test:release": "node scripts/validate-release.mjs",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "0.25.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild@0.25.0": true
  },
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.jimsabz.studio",
    "productName": "Jimsabz Studio",
    "asar": false,
    "files": [
      "electron/**/*",
      "api/**/*",
      "studio/**/*",
      "examples/**/*",
      "scripts/**/*",
      "docs/**/*",
      "jimsabz.json",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
